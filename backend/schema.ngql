-- ============================================================
-- 对公贷款反欺诈知识图谱 — NebulaGraph 5.x GQL 图模型
-- Schema：/default_schema
-- Graph：anti_fraud_kg
-- Graph Type：anti_fraud_kg_type
--
-- 5.x GQL 语句不要加分号。
-- Graph Type 必须声明 NODE / EDGE，空 AS {} 无法 INSERT (:company ...)。
-- ============================================================

CREATE GRAPH TYPE IF NOT EXISTS anti_fraud_kg_type AS {
  NODE company (LABELS company {id STRING PRIMARY KEY, name STRING, unified_code STRING, industry STRING, registered_capital FLOAT64, established_date STRING, address STRING, phone STRING, risk_score INT64, is_lost BOOL, lost_days INT64}),
  NODE person (LABELS person {id STRING PRIMARY KEY, name STRING, id_card STRING, phone STRING, address STRING, risk_score INT64}),
  NODE account (LABELS account {id STRING PRIMARY KEY, name STRING, account_no STRING, bank STRING, open_date STRING, risk_score INT64}),
  NODE loan (LABELS loan {id STRING PRIMARY KEY, name STRING, contract_no STRING, amount FLOAT64, currency STRING, issue_date STRING, maturity_date STRING, status STRING, risk_score INT64}),
  EDGE holds_account (company)-[:holds_account {rank INT64, open_date STRING, relation STRING}]->(account),
  EDGE applied_for_company_loan (company)-[:applied_for {rank INT64, apply_date STRING, amount FLOAT64}]->(loan),
  EDGE applied_for_person_loan (person)-[:applied_for {rank INT64, apply_date STRING, amount FLOAT64}]->(loan),
  EDGE disbursed_to (loan)-[:disbursed_to {rank INT64, disburse_date STRING, amount FLOAT64}]->(account),
  EDGE transfer (account)-[:transfer {rank INT64, tx_date STRING, amount FLOAT64, currency STRING, memo STRING, channel STRING}]->(account),
  EDGE guarantees (company)-[:guarantees {rank INT64, guarantee_date STRING, amount FLOAT64, guarantee_type STRING}]->(company),
  EDGE controls (person)-[:controls {rank INT64, relation STRING, share_ratio FLOAT64, since STRING}]->(company),
  EDGE shareholder_person_company (person)-[:shareholder {rank INT64, share_ratio FLOAT64, invest_amount FLOAT64}]->(company),
  EDGE shareholder_company_company (company)-[:shareholder {rank INT64, share_ratio FLOAT64, invest_amount FLOAT64}]->(company),
  EDGE employs (person)-[:employs {rank INT64, position STRING, since STRING}]->(company),
  EDGE related_to_company_company (company)-[:related_to {rank INT64, relation STRING, source STRING, since STRING}]->(company),
  EDGE related_to_person_person (person)-[:related_to {rank INT64, relation STRING, source STRING, since STRING}]->(person)
}
CREATE GRAPH IF NOT EXISTS anti_fraud_kg TYPED anti_fraud_kg_type
SESSION SET GRAPH anti_fraud_kg
