    "c_jinhai" -> "c_huaxin":("2023-07-15", 15000000.0, "连带责任保证"),
    "c_huaxin" -> "c_yuanhang":("2023-08-20", 12000000.0, "连带责任保证"),
    "c_yuanhang" -> "c_xinjiyuan":("2023-09-10", 8000000.0, "连带责任保证"),
    "c_xinjiyuan" -> "c_dongfang":("2023-10-05", 10000000.0, "连带责任保证");

insert edge controls(relation, share_ratio, since) values
    "c_dongfang" -> "c_yuanhang":("实际控制人", 0.51, "2019-01-01");

insert edge related_to(relation, source, since) values
    "c_dongfang" -> "c_jinhai":("同一办公地址", "工商", "2020-03-01"),
    "c_dongfang" -> "c_huaxin":("同一办公地址", "工商", "2020-03-01");

