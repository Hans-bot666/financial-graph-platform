-- ============================================================
-- 对公贷款反欺诈知识图谱 — 示例数据
-- 演示：贷款回流、担保圈、失联客户等场景
-- ============================================================

USE anti_fraud_kg;

-- ------------------------------------------------------------
-- 场景 1：凯达建材贷款回流
-- ------------------------------------------------------------

insert vertex company(name, unified_code, industry, registered_capital, address, phone, risk_score, is_lost, lost_days) values
    "c_kaida":("凯达建材有限公司", "91310000XXXXXXXXXX", "建材批发", 50000000.0, "上海市浦东新区张江路 1 号", "021-00001111", 90, false, 0),
    "c_yongsheng":("永盛砂石经营部", "91310000YYYYYYYYYY", "砂石销售", 3000000.0, "上海市嘉定区沪宜公路 2 号", "021-00002222", 60, false, 0);

insert vertex person(name, id_card, phone, address, risk_score) values
    "p_wang":("王某", "310XXXXXXXXXXXXXXX", "13800000001", "上海市浦东新区", 80),
    "p_spouse":("王某配偶", "310YYYYYYYYYYYYYYY", "13800000002", "上海市浦东新区", 85);

insert vertex account(name, account_no, bank, open_date, risk_score) values
    "a_loan_001":("贷款专户 6222", "6222XXXX0001", "工行浦东支行", "2024-01-10", 70),
    "a_spouse_8877":("配偶账户 8877", "8877XXXX0001", "招行上海分行", "2023-05-20", 85),
    "a_yongsheng_5566":("经营部账户 5566", "5566XXXX0001", "农行嘉定支行", "2023-08-15", 60);

insert vertex loan(name, contract_no, amount, currency, issue_date, maturity_date, status, risk_score) values
    "l_001":("凯达建材流动资金贷款", "DK-2024-0001", 5000000.0, "CNY", "2024-02-01", "2025-02-01", "正常", 90);

insert edge controls(relation, share_ratio, since) values
    "p_wang" -> "c_kaida":("实际控制人", 0.65, "2018-03-01");

insert edge related_to(relation, source, since) values
    "p_wang" -> "p_spouse":("配偶", "户籍", "2010-06-01");

insert edge holds_account(open_date, relation) values
    "c_kaida" -> "a_loan_001":("2024-01-10", "基本户"),
    "c_yongsheng" -> "a_yongsheng_5566":("2023-08-15", "一般户");

insert edge applied_for(apply_date, amount) values
    "c_kaida" -> "l_001":("2024-01-20", 5000000.0);

insert edge disbursed_to(disburse_date, amount) values
    "l_001" -> "a_loan_001":("2024-02-01", 5000000.0);

-- 贷款资金 → 经营部 → 配偶账户 → 提现/消费（贷款回流）
insert edge transfer(tx_date, amount, currency, memo, channel) values
    "a_loan_001" -> "a_yongsheng_5566":("2024-02-02 09:30:00", 4800000.0, "CNY", "货款", "网银"),
    "a_yongsheng_5566" -> "a_spouse_8877":("2024-02-03 14:20:00", 4500000.0, "CNY", "往来款", "跨行转账"),
    "a_spouse_8877" -> "p_wang":("2024-02-05 11:00:00", 2000000.0, "CNY", "消费/取现", "POS/ATM");

