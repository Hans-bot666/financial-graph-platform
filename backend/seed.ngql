    "c_huaxin":("华信供应链有限公司", "91310000BBBBBBBBBB", "供应链服务", 30000000.0, "上海市虹口区东大名路 12 号", "021-00005555", 68, false, 0),
    "c_yuanhang":("远航船务有限公司", "91310000CCCCCCCCCC", "航运", 80000000.0, "上海市虹口区东大名路 13 号", "021-00006666", 75, false, 0),
    "c_xinjiyuan":("新纪元仓储有限公司", "91310000DDDDDDDDDD", "仓储物流", 20000000.0, "上海市虹口区东大名路 14 号", "021-00007777", 55, false, 0);

insert edge guarantees(guarantee_date, amount, guarantee_type) values
