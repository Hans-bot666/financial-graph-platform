NEBULA_HOST=host.docker.internal
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=anti_fraud_kg
# 额外可查询图空间（逗号分隔）；探索分析下拉从此白名单加载
NEBULA_EXTRA_SPACES=nti_fraud_kg
NEBULA_POOL_MIN=1
NEBULA_POOL_MAX=10
NEBULA_TIMEOUT=0

# 用户认证（SQLite）
USER_DB_PATH=/app/data/users.db
SELF_REGISTRATION_ENABLED=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080

